# Copy to .env (never commit .env). Values match the local docker compose
# database; the passwords are placeholders.

# Runtime logins, one per group role. The pool refuses any other kind of login.
APP_DATABASE_URL=postgres://app_login:app-local-only@localhost:55440/rls_kit?sslmode=disable
PLATFORM_DATABASE_URL=postgres://platform_login:platform-local-only@localhost:55440/rls_kit?sslmode=disable
RELAY_DATABASE_URL=postgres://relay_login:relay-local-only@localhost:55440/rls_kit?sslmode=disable

# A BYPASSRLS login that is otherwise a plain app_user member. Exists only so
# the tests and demo can show the pool refusing it.
BYPASS_DATABASE_URL=postgres://bypass_login:bypass-local-only@localhost:55440/rls_kit?sslmode=disable

# Schema owner: migrations and the RLS smoke suite only. Never serves requests.
OWNER_DATABASE_URL=postgres://rls_owner:owner-local-only@localhost:55440/rls_kit?sslmode=disable

# Demo token verifier (HS256). Obviously fake; a real deployment verifies the
# identity provider's tokens via JWKS instead (see auth/).
AUTH_HS256_SECRET=demo-hs256-secret-FAKEFAKEFAKE-do-not-use
AUTH_ISSUER=https://issuer.example.test
AUTH_AUDIENCE=rls-kit-demo

HTTP_ADDR=127.0.0.1:8080
